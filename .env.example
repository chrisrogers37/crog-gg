# Backend environment variables for the Flask API (api/index.py).
# Every one is optional, locally and deployed. With none set, the site works:
# SUMMON NEW LORE is hidden (GET /api/features), and the project pages' GitHub
# panels call GitHub without a token, 60 requests an hour (GITHUB_TOKEN lifts
# that; features.github: off in site/site.yaml hides them).
#
# Nothing reads this file automatically. Copy it to `.env` (git-ignored),
# fill in what you need, and load it with `set -a; source .env; set +a`
# before running `python3 -m api.index` from the repo root. In production they're set in Vercel under
# Settings, Environment Variables.

# Enables POST /api/regenerate (the SUMMON NEW LORE button). The endpoint is
# public, so put a hard budget limit on this key in the OpenAI dashboard.
OPENAI_API_KEY=

# Upstash Redis REST credentials for the rate limits. Without them,
# /api/regenerate returns 503: the paid endpoint fails closed rather than run
# unmetered. The GitHub endpoints still work, without rate limits, except the
# /languages aggregate, which answers 503. The Vercel Marketplace integration
# injects these automatically. If UPSTASH_REDIS_REST_URL /
# UPSTASH_REDIS_REST_TOKEN are set, the client reads them first.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Keys the anonymous visitor tag that names visitors in rate-limit keys and log
# lines, and that /api/regenerate sends OpenAI as its safety_identifier: any
# random string of 32+ characters, kept secret, since anyone holding it can
# check which address a tag belongs to. Without it, keys and logs name visitors
# by address and the calls go without a safety_identifier. Setting or changing
# it resets every visitor's rate-limit windows once.
IP_HASH_SALT=

# Raises the GitHub API rate limits and is required for
# /api/v1/github/contributions. Use a classic token with no scopes, or a
# fine-grained token with read-only access to public repositories. Don't use
# `public_repo`: it can push to your public repos.
GITHUB_TOKEN=

# Optional: another rewrite model than the code's (#189). REGEN_GLOBAL_DAILY_MAX
# in api/index.py is sized from the default model's worst-case cost.
OPENAI_MODEL=

# Local only: set to true to allow the localhost origins in CORS.
FLASK_DEBUG=false
