# Backend environment variables for the Flask API (api/index.py).
# All of them are optional for local development: the site itself renders
# from the YAML in frontend/public/content/ without any of them.
#
# Nothing reads this file automatically. Export the variables in your shell
# (or use a loader such as direnv) before running `python3 -m api.index`
# from the repo root. In production they're set in Vercel under
# Settings, Environment Variables.

# Enables POST /api/regenerate (the SUMMON NEW LORE button). The endpoint is
# public, so put a hard budget limit on this key in the OpenAI dashboard.
OPENAI_API_KEY=

# Upstash Redis REST credentials for the rate limits. Without them,
# /api/regenerate returns 503: the paid endpoint fails closed rather than run
# unmetered. The GitHub endpoints still work, without rate limits. The Vercel
# Marketplace integration injects these automatically (the client also accepts
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Raises the GitHub API rate limits and is required for
# /api/v1/github/contributions. Use a classic token with no scopes, or a
# fine-grained token with read-only access to public repositories. Don't use
# `public_repo`: it can push to your public repos.
GITHUB_TOKEN=

# Local only: set to true to allow the localhost origins in CORS.
FLASK_DEBUG=false
