# Origin of the backend API. Leave it empty.
#
# In development the Vite dev server proxies /api/* to the Flask server on
# :5001 (see vite.config.ts), and in production the API is served from the
# same origin under /api/*. Pointing this at another origin makes the browser
# block the API calls.
VITE_API_URL=

# The repo this site is built from, e.g. https://github.com/you/your-site. When
# set, the footer links to it as "view source"; left empty, it shows no link.
VITE_SOURCE_REPO_URL=
