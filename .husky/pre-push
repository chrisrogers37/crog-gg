#!/usr/bin/env sh

# pre-push hook: runs the frontend build and tests, and CI's Python checks,
# for whichever side changed. Bypass with: git push --no-verify, or skip only
# the Python half with SKIP_PY_CHECKS=1 (CI still runs it).

set -e

echo "Running pre-push checks..."

# --- Determine changed files ---
# Compare against the upstream tracking branch or, for a new branch, the
# remote's main (a local main can be far behind it), then the local main.
UPSTREAM=$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null || echo "")
MERGE_BASE=""
for BASE in $UPSTREAM origin/main main; do
  MERGE_BASE=$(git merge-base HEAD "$BASE" 2>/dev/null || echo "")
  if [ -n "$MERGE_BASE" ]; then
    break
  fi
done

FRONTEND_CHANGED=false
PYTHON_CHANGED=false

if [ -n "$MERGE_BASE" ]; then
  # Diffing the merge base against the working tree covers both what's
  # committed and what isn't yet.
  CHANGED_FILES=$(git diff --name-only "$MERGE_BASE")

  if echo "$CHANGED_FILES" | grep -q "^frontend/"; then
    FRONTEND_CHANGED=true
  fi

  # The Python lives in api/, tests/ and conftest.py; its dependencies and
  # version are in the requirements files and .python-version.
  if echo "$CHANGED_FILES" | grep -qE "^(api/|tests/|conftest\.py$|requirements|\.python-version$)"; then
    PYTHON_CHANGED=true
  fi
else
  echo "Could not find a merge base to compare against - running all checks"
  FRONTEND_CHANGED=true
  PYTHON_CHANGED=true
fi

FAILED=0

# --- Frontend checks ---
if [ "$FRONTEND_CHANGED" = true ]; then
  echo ""
  echo "=== Frontend checks ==="

  echo "-> Running TypeScript + build..."
  if (cd frontend && npm run build); then
    echo "   Build passed"
  else
    echo "   Build FAILED"
    FAILED=1
  fi

  echo "-> Running tests..."
  if (cd frontend && npm run test:run); then
    echo "   Tests passed"
  else
    echo "   Tests FAILED"
    FAILED=1
  fi
else
  echo ""
  echo "=== Frontend: no changes detected, skipping ==="
fi

# --- Python checks: the same commands as CI's API Lint and API Tests ---
if [ "$PYTHON_CHANGED" = true ] && [ "${SKIP_PY_CHECKS:-}" = 1 ]; then
  echo ""
  echo "=== Python: SKIP_PY_CHECKS=1, skipping (CI still runs these) ==="
elif [ "$PYTHON_CHANGED" = true ]; then
  echo ""
  echo "=== Python checks ==="

  # A missing tool fails the push rather than skipping silently.
  PYTHON_TOOLS_MISSING=""
  for tool in flake8 black isort pytest; do
    if ! command -v "$tool" >/dev/null 2>&1; then
      PYTHON_TOOLS_MISSING="$PYTHON_TOOLS_MISSING $tool"
    fi
  done

  if [ -n "$PYTHON_TOOLS_MISSING" ]; then
    echo "   Missing:$PYTHON_TOOLS_MISSING"
    echo "   Install with: pip install -r requirements-dev.txt"
    echo "   Or push without the Python checks: SKIP_PY_CHECKS=1 git push"
    FAILED=1
  else
    echo "-> Running flake8..."
    if flake8 api --max-line-length=120 --ignore=E501,W503; then
      echo "   flake8 passed"
    else
      echo "   flake8 FAILED"
      FAILED=1
    fi

    echo "-> Running black --check..."
    if black --check --line-length=120 api; then
      echo "   black passed"
    else
      echo "   black FAILED"
      FAILED=1
    fi

    echo "-> Running isort --check..."
    if isort --check-only --profile black api; then
      echo "   isort passed"
    else
      echo "   isort FAILED"
      FAILED=1
    fi

    echo "-> Running pytest..."
    if pytest -q; then
      echo "   pytest passed"
    else
      echo "   pytest FAILED"
      FAILED=1
    fi
  fi
else
  echo ""
  echo "=== Python: no changes detected, skipping ==="
fi

# --- Summary ---
echo ""
if [ "$FAILED" -ne 0 ]; then
  echo "Pre-push checks FAILED. Fix issues above or bypass with: git push --no-verify"
  exit 1
fi

echo "All pre-push checks passed!"
