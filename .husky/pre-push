#!/usr/bin/env sh

# pre-push hook: runs the frontend's lint, type check, build and tests, and
# CI's Python checks, for whichever side changed. Bypass with: git push --no-verify, or skip only
# the Python half with SKIP_PY_CHECKS=1 (CI still runs it).

set -e

echo "Running pre-push checks..."

# --- Determine changed files ---
# Compare the whole branch against the remote's main, as CI's PR checks do, so
# commits pushed earlier with --no-verify are still covered. Without it, fall
# back to the upstream tracking branch, then the local main (which can be far
# behind the remote's).
UPSTREAM=$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null || echo "")
for BASE in origin/main $UPSTREAM main; do
  MERGE_BASE=$(git merge-base HEAD "$BASE" 2>/dev/null || echo "")
  if [ -n "$MERGE_BASE" ]; then
    echo "Comparing against $BASE"
    break
  fi
done

FRONTEND_CHANGED=false
PYTHON_CHANGED=false

if [ -n "$MERGE_BASE" ]; then
  # The net change from the merge base to the working tree: what's committed
  # and what isn't yet. --no-renames lists a moved file's old path too (a file
  # moved out of api/ is still a Python change), and quotePath=false keeps
  # non-ASCII paths unquoted, so the patterns below match them.
  CHANGED_FILES=$(git -c core.quotePath=false diff --name-only --no-renames "$MERGE_BASE")

  # site/ is the frontend's too: the build reads and checks site.yaml (#188),
  # and the unit tests read site.example/ (#191).
  if echo "$CHANGED_FILES" | grep -qE "^(frontend|site|site\.example)/"; then
    FRONTEND_CHANGED=true
  fi

  # Dependency, Python version and tool config changes count too, and the
  # site.yaml files the API and its tests read, and vercel.json, which bundles
  # one with the function (#189).
  if echo "$CHANGED_FILES" | grep -qE "^(api/|tests/|conftest\.py$|requirements|\.python-version$|setup\.cfg$|pyproject\.toml$|\.flake8$|pytest\.ini$|site/site\.yaml$|site\.example/site\.yaml$|vercel\.json$)"; then
    PYTHON_CHANGED=true
  fi
else
  echo "Could not find a merge base to compare against - running all checks"
  FRONTEND_CHANGED=true
  PYTHON_CHANGED=true
fi

FAILED=0

# Runs one check, recording a failure without stopping the others.
check() {
  label=$1
  shift
  echo "-> Running $label..."
  if "$@"; then
    echo "   $label passed"
  else
    echo "   $label FAILED"
    FAILED=1
  fi
}

# --- Frontend checks ---
echo ""
if [ "$FRONTEND_CHANGED" = true ]; then
  echo "=== Frontend checks ==="
  check "lint" npm --prefix frontend run lint
  check "type check" npm --prefix frontend run typecheck
  check "build" npm --prefix frontend run build
  check "tests" npm --prefix frontend run test:run
else
  echo "=== Frontend: no changes detected, skipping ==="
fi

# --- Python checks: the same commands as CI's API Lint and API Tests ---
echo ""
if [ "$PYTHON_CHANGED" != true ]; then
  echo "=== Python: no changes detected, skipping ==="
elif [ "${SKIP_PY_CHECKS:-}" = 1 ]; then
  echo "=== Python: SKIP_PY_CHECKS=1, skipping (CI still runs these) ==="
else
  echo "=== Python checks ==="

  # A missing tool fails the push rather than skipping silently.
  PYTHON_TOOLS_MISSING=""
  for tool in flake8 black isort pytest; do
    if ! command -v "$tool" >/dev/null 2>&1; then
      PYTHON_TOOLS_MISSING="$PYTHON_TOOLS_MISSING $tool"
    fi
  done

  if [ -n "$PYTHON_TOOLS_MISSING" ]; then
    echo "   Missing:$PYTHON_TOOLS_MISSING"
    echo "   Install with: pip install -r requirements-dev.txt"
    echo "   Or push without the Python checks: SKIP_PY_CHECKS=1 git push"
    FAILED=1
  else
    check "flake8" flake8 api --max-line-length=120 --ignore=E501,W503
    check "black" black --check --line-length=120 api
    check "isort" isort --check-only --profile black api
    check "pytest" pytest -q
  fi
fi

# --- Summary ---
echo ""
if [ "$FAILED" -ne 0 ]; then
  echo "Pre-push checks FAILED. Fix issues above or bypass with: git push --no-verify"
  exit 1
fi

echo "All pre-push checks passed!"
