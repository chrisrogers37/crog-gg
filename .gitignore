# System Files
.DS_Store
Thumbs.db 
.vercel

# Agent telemetry: supervision hooks may write these relative to the session
# cwd instead of the bot directory, so they can land at any depth. They are
# never product data.
**/data/events/fleet-*.jsonl
**/data/.last-tool-call
**/data/.idle

# local virtualenv (repo already ignores venv/, not .venv/)
.venv/

# Personal Claude Code settings (keep machine-specific permissions out of the repo)
.claude/settings.local.json
